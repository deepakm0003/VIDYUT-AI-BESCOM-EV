# Frontend Environment Configuration
# Copy this file to .env and update values as needed

# API Configuration
VITE_API_BASE=http://localhost:8000/api
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=VIDYUT AI

# Feature Flags
VITE_ENABLE_SSE_ALERTS=true
VITE_ENABLE_MAP_TILES=true
VITE_DEBUG_MODE=false

# Polling Intervals (milliseconds)
VITE_HEALTH_CHECK_INTERVAL=30000
VITE_FEEDER_STATUS_INTERVAL=15000
VITE_SCHEDULER_STATUS_INTERVAL=5000
VITE_CARBON_SUMMARY_INTERVAL=60000

# SSE Configuration
VITE_SSE_RECONNECT_DELAY=3000
VITE_SSE_STREAM_URL=/api/alerts/stream

# Map Configuration
VITE_MAP_CENTER_LAT=12.9716
VITE_MAP_CENTER_LNG=77.5946
VITE_MAP_ZOOM=11
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false
VITE_SENTRY_DSN=

# Build Configuration
VITE_BUILD_SOURCEMAP=false
